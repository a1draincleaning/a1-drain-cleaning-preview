---
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
---
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
---
<header class:list={["site-header", { "site-header--overlay": overlay }]}>
  <div class="header-topline">
    <div class="container header-topline-inner">
      <span>MASON CITY, IOWA <i aria-hidden="true">/</i> LOCAL DRAIN &amp; SEWER SERVICE</span>
      <span class="header-topline-note">Serving nine North Iowa counties</span>
    </div>
  </div>
  <div class="container header-main">
    <a href={withBase('/')} class="brand-link" aria-label="A-1 Drain Cleaning home">
      <img src={withBase('/a1-logo.svg')} alt="A-1 Drain Cleaning" width="768" height="256" fetchpriority="high" loading="eager" decoding="async">
      <span class="brand-caption">DRAIN CLEANING <i aria-hidden="true">/</i> MASON CITY, IOWA</span>
    </a>
    <div class="header-action">
      <span class="header-action-label">Clogged drain? Sewer backing up?</span>
      <a href="tel:+16415302728" class="header-call-cta call-button" aria-label="Call A-1 Drain Cleaning at 641-530-2728">
        <span class="call-label">CALL A-1 DRAIN CLEANING</span>
        <strong>641-530-2728</strong>
      </a>
      <span class="header-action-foot">24/7 drain and sewer service</span>
    </div>
  </div>
  <nav aria-label="Main navigation" class="site-nav">
    <div class="container nav-inner">
      <a href={withBase('/')}>Home</a>
      <a href={withBase('/services/')}>Drain &amp; Sewer Services</a>
      <a href={withBase('/services/sewer-backup-emergency/')}>Emergency Backups</a>
      <a href={withBase('/services/hydro-jetting/')}>Hydro-Jetting</a>
      <a href={withBase('/services/sewer-line-cleaning/')}>Sewer Lines</a>
      <a href={withBase('/service-area/')}>Service Area</a>
      <a href={withBase('/about/')}>About Josh</a>
      <a href={withBase('/contact/')}>Contact</a>
    </div>
  </nav>
</header>
