---
import TrustBadge from './TrustBadge.astro';
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<TrustBadge />
<footer class="site-footer">
  <div class="container footer-grid">
    <section class="footer-business">
      <p class="footer-brand">A-1 Drain Cleaning</p>
      <p class="footer-location">Mason City, Iowa</p>
      <address>
        206 29th St SW<br>
        Mason City, Iowa 50401
      </address>
      <p class="footer-service-note">Drain cleaning, sewer line cleaning, and backup service.</p>
    </section>
    <section class="footer-contact">
      <h2>Need a drain cleared?</h2>
      <a class="footer-phone" href="tel:+16415302728">641-530-2728</a>
      <p>Call A-1 Drain Cleaning any time. Explain what is backing up and where you are located.</p>
    </section>
    <nav aria-label="Footer service navigation">
      <h2>Drain &amp; Sewer Services</h2>
      <ul>
        <li><a href={withBase('/services/')}>All services</a></li>
        <li><a href={withBase('/services/main-drain-cleaning/')}>Main drain cleaning</a></li>
        <li><a href={withBase('/services/sewer-line-cleaning/')}>Sewer line cleaning</a></li>
        <li><a href={withBase('/services/basement-floor-drains/')}>Basement floor drains</a></li>
        <li><a href={withBase('/services/tree-roots-in-sewer-line/')}>Tree roots in sewer lines</a></li>
        <li><a href={withBase('/services/hydro-jetting/')}>Hydro-jetting</a></li>
        <li><a href={withBase('/services/smoke-testing/')}>Smoke testing</a></li>
      </ul>
    </nav>
    <nav aria-label="Cities served">
      <h2>Nearby City Pages</h2>
      <ul>
        <li><a href={withBase('/mason-city-drain-cleaning/')}>Mason City</a></li>
        <li><a href={withBase('/service-area/clear-lake/')}>Clear Lake</a></li>
        <li><a href={withBase('/service-area/charles-city/')}>Charles City</a></li>
        <li><a href={withBase('/service-area/forest-city/')}>Forest City</a></li>
        <li><a href={withBase('/service-area/garner/')}>Garner</a></li>
        <li><a href={withBase('/service-area/hampton/')}>Hampton</a></li>
        <li><a href={withBase('/service-area/nora-springs/')}>Nora Springs</a></li>
        <li><a href={withBase('/service-area/northwood/')}>Northwood</a></li>
        <li><a href={withBase('/service-area/rockwell/')}>Rockwell</a></li>
        <li><a href={withBase('/albert-lea-mn-drain-cleaning/')}>Albert Lea, Minnesota</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer-bottom">
    <nav aria-label="Additional footer links">
      <a href={withBase('/about/')}>About</a>
      <a href={withBase('/service-area/')}>Service area</a>
      <a href={withBase('/contact/')}>Contact</a>
      <a href={withBase('/privacy-policy/')}>Privacy</a>
      <a href={withBase('/terms/')}>Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} A-1 Drain Cleaning. All rights reserved.</p>
  </div>
</footer>
<style>
.site-footer { background:#101d2a; color:#f4f7f9; padding:3.5rem 0 2rem; border-top:5px solid #1676a8; }
.footer-grid { display:grid; grid-template-columns:1.1fr 1fr 1fr 1fr; gap:2.25rem; }
.site-footer h2 { margin:0 0 1rem; color:#9bd8f3; font-size:.78rem; font-weight:900; letter-spacing:.13em; text-transform:uppercase; }
.footer-brand { margin:0; font-size:1.8rem; font-weight:950; letter-spacing:-.04em; line-height:1.1; }
.footer-location { margin:.4rem 0 0; color:#9bd8f3; font-weight:800; }
.site-footer address { margin-top:1.2rem; font-style:normal; line-height:1.8; }
.footer-service-note,.footer-contact p { margin-top:1rem; color:#c8d2d9; line-height:1.7; font-size:.92rem; }
.footer-phone { display:inline-block; color:#fff; font-size:1.8rem; font-weight:950; text-decoration:underline; text-decoration-color:#f06424; text-decoration-thickness:3px; text-underline-offset:5px; }
.site-footer ul { margin:0; padding:0; list-style:none; }
.site-footer li+li { margin-top:.55rem; }
.site-footer a { color:#edf3f6; text-decoration:none; }
.site-footer a:hover { color:#9bd8f3; text-decoration:underline; }
.footer-bottom { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-top:2.5rem; padding-top:1.4rem; border-top:1px solid #354653; color:#b9c6cf; font-size:.82rem; }
.footer-bottom nav { display:flex; flex-wrap:wrap; gap:1.2rem; }
.footer-bottom p { margin:0; }
@media(max-width:800px){ .footer-grid{grid-template-columns:1fr 1fr;} }
@media(max-width:540px){ .footer-grid{grid-template-columns:1fr; gap:2rem;} .footer-bottom{align-items:flex-start; flex-direction:column;} }
</style>
