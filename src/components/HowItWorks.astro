---
const steps = [
  { n: '01', title: 'Tell us what is happening', text: 'Call A-1 Drain Cleaning and describe which drain is affected, when it backs up, and whether other fixtures are involved.' },
  { n: '02', title: 'We check the problem', text: 'We look at the affected fixture, drain access and symptoms to work out where the restriction may be.' },
  { n: '03', title: 'Clear the blockage', text: 'We use the drain-cleaning equipment and method that fit the line, the blockage and the access available.' },
  { n: '04', title: 'Explain what we found', text: 'We explain what was cleared and whether the symptoms suggest further inspection may be useful.' }
];
---
<section class="bg-[#202326] py-16 text-white sm:py-20" aria-labelledby="how-a1-works">
  <div class="container">
    <p class="text-sm font-black uppercase tracking-[0.2em] text-[#f6a16e]">What happens when you call</p>
    <h2 id="how-a1-works" class="mt-2 max-w-4xl text-4xl font-black tracking-tight sm:text-5xl">How an A-1 drain call works.</h2>
    <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => <article class="border-t-2 border-[#f36b21] pt-5"><p class="text-sm font-black tracking-[0.2em] text-[#f6a16e]">{step.n}</p><h3 class="mt-3 text-xl font-black">{step.title}</h3><p class="mt-3 text-base leading-7 text-slate-300">{step.text}</p></article>)}
    </div>
    <a href="tel:+16415302728" class="mt-10 inline-flex min-h-12 items-center justify-center bg-[#f36b21] px-6 py-3 font-black text-white hover:bg-[#d95712]">CALL 641-530-2728 →</a>
  </div>
</section>