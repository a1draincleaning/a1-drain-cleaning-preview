---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import WhereDrainsGoWrong from '../components/WhereDrainsGoWrong.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import GoogleBusinessInfo from '../components/GoogleBusinessInfo.astro';
import ServiceAreaCityLinks from '../components/ServiceAreaCityLinks.astro';
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<MainLayout
  title="A-1 Drain Cleaning | Drain Cleaning & Sewer Service in Mason City, Iowa"
  description="Basement floor drain backing up? Main sewer line clogged? A-1 Drain Cleaning clears drain and sewer problems in Mason City and North Iowa. Call 641-530-2728."
  path="/"
>
  <main id="main" class="dc-home">
    <section class="dc-hero" aria-labelledby="hero-title" style={`--dc-hero-image: url("${withBase('/images/a1-main-sewer-drain-cleaning-mason-city.webp')}")`}>
      <Header overlay />
      <div class="dc-wrap dc-hero-grid">
        <div class="dc-hero-copy">
          <p class="dc-eyebrow">Mason City, Iowa · North Iowa drain service</p>
          <h1 id="hero-title">Drain backed up?<br><span>Let's get it flowing.</span></h1>
          <p class="dc-lead">Basement floor drain overflowing? Main sewer line plugged? Washer pushing water back into the basement? Josh at A-1 Drain Cleaning clears stubborn drain and sewer problems across North Iowa.</p>
          <a class="dc-button" href="tel:+16415302728">Call 641-530-2728 <span aria-hidden="true">→</span></a>
          <p class="dc-availability">24/7 service for drain and sewer problems.</p>
          <ul class="dc-proof"><li>Locally owned in Mason City</li><li>Residential and commercial</li><li>Call Josh directly</li></ul>
        </div>
      </div>
    </section>

    <section class="dc-symptoms dc-section" aria-labelledby="symptom-title">
      <div class="dc-wrap">
        <p class="dc-eyebrow">Start with what you're seeing</p>
        <h2 id="symptom-title">What's your drain doing?</h2>
        <p class="dc-intro">Pick the symptom that sounds closest. The fixture where water shows up can help narrow down where the restriction may be.</p>
        <div class="dc-symptom-grid">
          <a href={withBase('/services/basement-floor-drains/')}><b>01</b><strong>Basement floor drain backing up</strong><span>Sewage or dirty water coming up through the floor drain.</span></a>
          <a href={withBase('/services/laundry-drains/')}><b>02</b><strong>Washer makes water back up</strong><span>Water spilling from the standpipe or nearby floor drain.</span></a>
          <a href={withBase('/services/kitchen-drains/')}><b>03</b><strong>Kitchen sink won't drain</strong><span>Slow drainage, standing water or a complete blockage.</span></a>
          <a href={withBase('/services/bathroom-shower-drains/')}><b>04</b><strong>Bathtub or shower won't drain</strong><span>Water standing in the tub or shower, or draining slowly.</span></a>
          <a href={withBase('/services/main-drain-cleaning/')}><b>05</b><strong>Several fixtures backing up</strong><span>Toilet, tub or floor drain reacts when another fixture runs.</span></a>
          <a href={withBase('/services/sewer-line-cleaning/')}><b>06</b><strong>Main sewer line keeps clogging</strong><span>A blockage returns after the line has been cleared.</span></a>
          <a href={withBase('/services/tree-roots-in-sewer-line/')}><b>07</b><strong>Roots in the sewer line</strong><span>Recurring trouble that may need cutting and inspection.</span></a>
        </div>
      </div>
    </section>

    <section class="dc-services dc-section" aria-labelledby="services-title">
      <div class="dc-wrap">
        <p class="dc-eyebrow">What A-1 does</p>
        <h2 id="services-title">Drain and sewer work, from the fixture to the main line.</h2>
        <p class="dc-intro">The right method depends on where the blockage is, what is in the pipe and the condition of the line.</p>
        <div class="dc-service-list">
          <article class="dc-service-row">
            <div class="dc-service-copy"><span class="dc-number">01</span><h3>Drain cleaning and clog removal</h3><p>Blocked sinks, tubs, showers, toilets and branch drains. The tool and cable size depend on the drain and the obstruction.</p><a href={withBase('/services/kitchen-drains/')}>Kitchen and bathroom drain service →</a></div>
            <img src={withBase('/images/clogged-bathtub-drain-mason-city-iowa.webp')} alt="Clogged bathtub drain in a Mason City home" width="900" height="650" loading="lazy" />
          </article>
          <article class="dc-service-row dc-reverse">
            <div class="dc-service-copy"><span class="dc-number">02</span><h3>Main drain and sewer line cleaning</h3><p>When several fixtures are affected or wastewater comes up through the lowest drain, the restriction may be in a shared line or the main sewer.</p><a href={withBase('/services/main-drain-cleaning/')}>Main drain cleaning →</a></div>
            <img src={withBase('/images/sewer-drain-mason-city-iowa.jpg')} alt="Sewer drain cleaning work by A-1 Drain Cleaning" width="900" height="650" loading="lazy" />
          </article>
          <article class="dc-service-row">
            <div class="dc-service-copy"><span class="dc-number">03</span><h3>Basement floor drain backups</h3><p>Floor drain overflow can happen when a downstream drain or sewer line cannot carry wastewater away. Stop using water and describe which fixtures were running.</p><a href={withBase('/services/basement-floor-drains/')}>Basement and floor drains →</a></div>
            <img src={withBase('/images/floor-drain-backing-up-mason-city-iowa.jpeg')} alt="Basement floor drain backup service in Mason City, Iowa" width="900" height="650" loading="lazy" />
          </article>
          <article class="dc-service-row dc-reverse">
            <div class="dc-service-copy"><span class="dc-number">04</span><h3>Tree root cutting and sewer inspection</h3><p>Roots can enter through joints or damaged sections and catch debris. Camera inspection can help identify why a blockage keeps returning.</p><a href={withBase('/services/tree-roots-in-sewer-line/')}>Tree roots in sewer lines →</a></div>
            <img src={withBase('/images/tree-root-removal-mason-city-iowa.jpg')} alt="Tree root removal from a sewer line" width="900" height="650" loading="lazy" />
          </article>
          <article class="dc-service-row">
            <div class="dc-service-copy"><span class="dc-number">05</span><h3>High-pressure hydro jetting</h3><p>Hydro jetting uses pressurized water to remove grease, sludge and other buildup when the pipe condition and access make it the right method.</p><a href={withBase('/services/hydro-jetting/')}>Hydro jetting service →</a></div>
            <img src={withBase('/images/a1-main-sewer-drain-cleaning-mason-city.webp')} alt="A-1 Drain Cleaning equipment used for drain and sewer cleaning" width="900" height="650" loading="lazy" />
          </article>
          <article class="dc-service-row dc-reverse">
            <div class="dc-service-copy"><span class="dc-number">06</span><h3>Drain camera inspection and line locating</h3><p>When a blockage keeps returning or the location of a line is unclear, inspection and locating equipment can help identify what is happening and where the pipe runs.</p><a href={withBase('/services/sewer-camera-inspection/')}>Camera inspection and sewer diagnosis →</a></div>
            <img src={withBase('/images/sewer-drain-mason-city-iowa.jpg')} alt="Sewer line service work by A-1 Drain Cleaning" width="900" height="650" loading="lazy" />
          </article>
          <article class="dc-service-row">
            <div class="dc-service-copy"><span class="dc-number">07</span><h3>Drain repair and smoke testing</h3><p>When symptoms point to a damaged drain or an unknown opening, the next step depends on inspection findings. Smoke testing can help locate certain defects in a drain system.</p><a href={withBase('/services/smoke-testing/')}>Smoke testing information →</a></div>
            <img src={withBase('/images/tree-root-removal-mason-city-iowa.jpg')} alt="Drain and sewer inspection work" width="900" height="650" loading="lazy" />
          </article>
        </div>
      </div>
    </section>

    <WhereDrainsGoWrong />

    <section class="dc-method dc-section" aria-labelledby="method-title">
      <div class="dc-wrap dc-method-grid">
        <div><p class="dc-eyebrow">Equipment and methods</p><h2 id="method-title">The right tool depends on the line.</h2><p>A-1 uses equipment suited to the blockage, access and condition of the pipe. Clearing a clog and finding the reason it keeps coming back are two different jobs.</p></div>
        <div class="dc-method-cards">
          <article><b>Drain machines</b><p>Different cable sizes and cutting heads for suitable drain and sewer blockages.</p></article>
          <article><b>Sewer cameras</b><p>Camera inspection can show roots, buildup, damage or other trouble inside a line.</p></article>
          <article><b>Line locating</b><p>Locating equipment helps identify where an underground drain or sewer line runs.</p></article>
          <article><b>Hydro-jetting</b><p>Pressurized water can remove buildup when the pipe condition and blockage make jetting appropriate.</p></article>
          <article><b>Smoke testing</b><p>Smoke testing can help locate openings or defects in a drain system when that test is appropriate.</p></article>
          <article><b>Pipe materials</b><p>Older North Iowa properties may have clay tile or cast iron; some properties have PVC or other materials. The pipe needs to be identified before choosing a method.</p></article>
        </div>
      </div>
    </section>

    <section class="dc-coverage dc-section" aria-labelledby="coverage-title">
      <div class="dc-wrap dc-coverage-grid">
        <div><p class="dc-eyebrow">North Iowa coverage</p><h2 id="coverage-title">Based in Mason City. Working across North Iowa.</h2><p>A-1 Drain Cleaning is based at 206 29th St SW in Mason City, Iowa. Service includes Mason City and surrounding communities across the North Iowa area.</p><a href={withBase('/service-area/')}>See the service area →</a></div>
        <ServiceAreaCityLinks />
      </div>
    </section>

    <section class="dc-work dc-section" aria-labelledby="work-title">
      <div class="dc-wrap">
        <p class="dc-eyebrow">Recent drain and sewer work</p>
        <h2 id="work-title">A look at the problems A-1 gets called to clear.</h2>
        <p class="dc-intro">Photos from A-1 Drain Cleaning work and the types of blockages handled around Mason City and North Iowa.</p>
        <div class="dc-work-grid">
          <figure><img src={withBase('/images/floor-drain-backing-up-mason-city-iowa.jpeg')} alt="Basement floor drain backup in a Mason City home" width="900" height="650" loading="lazy"><figcaption><strong>Basement floor drain backup</strong><span>Wastewater coming up through a low floor drain can point to a downstream restriction.</span></figcaption></figure>
          <figure><img src={withBase('/images/tree-root-removal-mason-city-iowa.jpg')} alt="Tree roots removed from a sewer line" width="900" height="650" loading="lazy"><figcaption><strong>Roots in a sewer line</strong><span>Roots can enter at joints or damaged pipe and catch debris.</span></figcaption></figure>
          <figure><img src={withBase('/images/clogged-bathtub-drain-mason-city-iowa.webp')} alt="Clogged bathtub drain" width="900" height="650" loading="lazy"><figcaption><strong>Bathroom drain clog</strong><span>Hair, soap residue and buildup can slow a tub or shower drain.</span></figcaption></figure>
          <figure><img src={withBase('/images/sewer-drain-mason-city-iowa.jpg')} alt="A-1 Drain Cleaning sewer drain service" width="900" height="650" loading="lazy"><figcaption><strong>Main drain and sewer service</strong><span>The right cleaning method depends on the pipe, access and blockage.</span></figcaption></figure>
        </div>
      </div>
    </section>

    <section class="dc-customers dc-section" aria-labelledby="customers-title">
      <div class="dc-wrap">
        <p class="dc-eyebrow">Who A-1 works for</p>
        <h2 id="customers-title">Drain cleaning for homes, rentals and businesses.</h2>
        <p class="dc-intro">A backed-up drain can shut down a bathroom, laundry room, rental unit or business. Explain what is affected when you call Josh.</p>
        <div class="dc-customer-grid">
          <article><span>01</span><h3>Homeowners</h3><p>Floor drain backups, clogged sinks and tubs, laundry drain overflows, toilet clogs and main sewer problems.</p></article>
          <article><span>02</span><h3>Landlords and property owners</h3><p>Drain and sewer blockages in rental homes and multi-unit properties. Tell Josh which unit and fixtures are affected.</p></article>
          <article><span>03</span><h3>Businesses</h3><p>Drain and sewer cleaning when a restroom, kitchen or other part of the building cannot be used normally.</p></article>
          <article><span>04</span><h3>Property managers</h3><p>Service for properties around Mason City and surrounding North Iowa communities. Call to confirm coverage for a specific address.</p></article>
        </div>
      </div>
    </section>

    <section class="dc-about dc-section" aria-labelledby="about-title">
      <div class="dc-wrap dc-about-grid">
        <img src={withBase('/images/trusted-local-service-iowa.png')} alt="A-1 Drain Cleaning local service in Iowa" width="900" height="700" loading="lazy" />
        <div><p class="dc-eyebrow">Locally owned and operated</p><h2 id="about-title">A straight answer from Josh.</h2><p>Josh Theilen owns A-1 Drain Cleaning and handles drain and sewer work from Mason City. When you call, explain what is backing up, which fixtures are affected and what was running when it started.</p><p>That information helps narrow down where to start. You do not need to know the technical name of the problem.</p><a href={withBase('/about/')}>About A-1 Drain Cleaning →</a></div>
      </div>
    </section>

    <section class="dc-faq dc-section" aria-labelledby="faq-title">
      <div class="dc-wrap"><p class="dc-eyebrow">Straight answers</p><h2 id="faq-title">Questions about drain backups.</h2>
        <div class="dc-faq-list">
          <details><summary>Sewage is coming up through my basement floor drain. What should I do?</summary><p>Stop using toilets, sinks, showers and the washing machine as much as possible. Keep children and pets away and avoid contact with wastewater. Call A-1 Drain Cleaning at <a href="tel:+16415302728">641-530-2728</a>. Tell Josh which fixtures were running and whether more than one drain is affected.</p></details>
          <details><summary>Why does my washing machine make water come out of the floor drain?</summary><p>A washer pumps out a large amount of water in a short time. If the laundry drain or a shared line cannot carry it away, water can spill from the standpipe or push up through a nearby floor drain. Stop running the washer until the drain is checked.</p></details>
          <details><summary>My house has no basement. Where does a sewer backup show up?</summary><p>In a slab house or a home without a basement, wastewater from a blocked main drain or sewer line may back up into a bathtub or shower. Tell Josh which fixture filled first and whether other drains are affected.</p></details>
          <details><summary>Why does my sewer line keep clogging?</summary><p>Roots, damaged pipe, buildup or a restriction that was not fully removed can cause a blockage to return. A camera inspection, when suitable, can help show what is happening inside the line.</p></details>
          <details><summary>Does A-1 Drain Cleaning offer emergency service?</summary><p>A-1 Drain Cleaning offers 24/7 service for drain and sewer problems in Mason City and surrounding North Iowa communities. Call <a href="tel:+16415302728">641-530-2728</a> and explain what is backing up.</p></details>
        </div>
      </div>
    </section>

    <ContactCTA showForm />
    <GoogleBusinessInfo />
  </main>
  <Footer />
</MainLayout>

<style>
.dc-home{--dc-ink:#202b30;--dc-muted:#657177;--dc-blue:#164e63;--dc-orange:#e9682b;--dc-paper:#f5f5f1;color:var(--dc-ink);background:#fff}
.dc-wrap{width:min(1180px,calc(100% - 40px));margin-inline:auto}
.dc-section{padding:clamp(56px,7vw,96px) 0}
.dc-eyebrow{margin:0 0 14px;color:var(--dc-orange);font-size:12px;font-weight:900;letter-spacing:.17em;text-transform:uppercase}
.dc-home h2{max-width:820px;margin:0;color:var(--dc-ink);font-size:clamp(32px,4.2vw,54px);font-weight:850;line-height:1.06;letter-spacing:-.045em}
.dc-intro{max-width:720px;margin:18px 0 34px;color:var(--dc-muted);font-size:18px;line-height:1.65}
.dc-hero{position:relative;isolation:isolate;overflow:hidden;background:#163d4b var(--dc-hero-image) center 48%/cover no-repeat;color:#fff}
.dc-hero .site-header--overlay{position:absolute;z-index:5;top:0;right:0;left:0;background:rgba(9,28,39,.48);border-top:4px solid #f06424;box-shadow:0 8px 24px rgba(0,0,0,.12);backdrop-filter:blur(5px)}
.dc-hero .site-header--overlay .header-topline{background:rgba(5,20,29,.38)}
.dc-hero .site-header--overlay .site-nav{background:rgba(12,43,58,.48);border-top:1px solid rgba(255,255,255,.16)}
.dc-hero .site-header--overlay .nav-inner a:hover,.dc-hero .site-header--overlay .nav-inner a:focus-visible{background:rgba(255,255,255,.12)}
.dc-hero:before{position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(7,25,32,.88) 0%,rgba(7,25,32,.72) 52%,rgba(7,25,32,.48) 100%);content:''}
.dc-hero-grid{display:grid;grid-template-columns:minmax(0,760px);align-items:center;min-height:clamp(520px,62vw,700px);padding-block:230px 76px}
.dc-hero .dc-eyebrow{color:#f5a47d}
.dc-hero h1{margin:0;color:#fff;font-size:clamp(44px,6.2vw,78px);font-weight:900;line-height:.98;letter-spacing:-.06em}
.dc-hero h1 span{color:#f18a55}
.dc-lead{max-width:620px;margin:25px 0;color:#e1e9e9;font-size:clamp(17px,1.7vw,20px);line-height:1.65}
.dc-button{display:inline-flex;min-height:56px;align-items:center;gap:24px;padding:15px 23px;background:var(--dc-orange);color:white;font-size:15px;font-weight:900;text-decoration:none}
.dc-button:hover{background:#cc5120}.dc-availability{margin:15px 0 0;color:#d3dfdf;font-size:14px}
.dc-proof{display:flex;flex-wrap:wrap;gap:8px 20px;margin:25px 0 0;padding:0;list-style:none;color:#e5eded;font-size:13px;font-weight:700}
.dc-proof li:before{content:'✓';margin-right:8px;color:#f18a55}
.dc-hero-image{position:relative;margin:0;background:#0e2d38}
.dc-hero-image img{display:block;width:100%;height:clamp(320px,39vw,500px);object-fit:cover}
.dc-hero-image figcaption{padding:13px 17px;color:#fff;background:#0e2d38;font-size:13px}
.dc-symptoms{background:#f5f5f1}
.dc-symptom-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #d7dddc;border-left:1px solid #d7dddc}
.dc-symptom-grid a{display:flex;min-height:190px;flex-direction:column;padding:23px;border-right:1px solid #d7dddc;border-bottom:1px solid #d7dddc;text-decoration:none;transition:background .2s}
.dc-symptom-grid a:hover{background:#fff}
.dc-symptom-grid b,.dc-number{color:var(--dc-orange);font-size:13px;letter-spacing:.1em}
.dc-symptom-grid strong{margin:18px 0 8px;font-size:18px;line-height:1.25}
.dc-symptom-grid span{color:var(--dc-muted);font-size:14px;line-height:1.5}
.dc-services{background:#fff}
.dc-service-list{border-top:1px solid #d9dfde}
.dc-service-row{display:grid;grid-template-columns:1fr .9fr;gap:clamp(28px,6vw,80px);align-items:center;padding:35px 0;border-bottom:1px solid #d9dfde}
.dc-service-row.dc-reverse .dc-service-copy{order:2}.dc-service-row.dc-reverse img{order:1}
.dc-service-row img{display:block;width:100%;height:280px;object-fit:cover}
.dc-service-copy h3{margin:10px 0;font-size:clamp(25px,3vw,36px);font-weight:850;line-height:1.1;letter-spacing:-.035em}
.dc-service-copy p{max-width:560px;color:var(--dc-muted);line-height:1.7}
.dc-service-copy a,.dc-coverage a,.dc-about a{display:inline-block;margin-top:8px;color:var(--dc-blue);font-size:14px;font-weight:850;text-decoration:underline;text-underline-offset:4px}
.dc-method{background:#f0f2ef}
.dc-method-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}
.dc-method-grid>div:first-child p:not(.dc-eyebrow){color:var(--dc-muted);line-height:1.75}
.dc-method-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.dc-method-cards article{padding:22px;background:#fff;border:1px solid #dfe3df}
.dc-method-cards b{font-size:17px}.dc-method-cards p{margin:8px 0 0;color:var(--dc-muted);font-size:14px;line-height:1.6}
.dc-coverage{background:#163d4b;color:#fff}
.dc-coverage h2{color:#fff}.dc-coverage-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;align-items:start}
.dc-coverage-grid>div:first-child p:not(.dc-eyebrow){color:#d7e2e2;line-height:1.75}
.dc-coverage a{color:#fff}
.dc-about{background:#fff}.dc-about-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:center}
.dc-about-grid img{width:100%;height:360px;object-fit:cover}.dc-about-grid p:not(.dc-eyebrow){color:var(--dc-muted);line-height:1.75}
.dc-faq{background:#f5f5f1}.dc-faq-list{margin-top:32px;border-top:1px solid #d5dcda}
.dc-faq-list details{padding:20px 2px;border-bottom:1px solid #d5dcda}
.dc-faq-list summary{cursor:pointer;font-size:18px;font-weight:800}.dc-faq-list p{max-width:850px;color:var(--dc-muted);line-height:1.75}.dc-faq-list a{color:var(--dc-blue);font-weight:800}
.dc-work{background:#fff}
.dc-work-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:34px}
.dc-work-grid figure{margin:0;background:#f3f4f1;border:1px solid #dce1de}
.dc-work-grid img{display:block;width:100%;height:220px;object-fit:cover}
.dc-work-grid figcaption{display:grid;gap:7px;padding:17px}
.dc-work-grid figcaption strong{font-size:17px;line-height:1.3}
.dc-work-grid figcaption span{color:var(--dc-muted);font-size:14px;line-height:1.55}
.dc-customers{background:#f0f2ef}
.dc-customer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:34px}
.dc-customer-grid article{padding:24px;background:#fff;border:1px solid #dfe3df}
.dc-customer-grid article>span{color:var(--dc-orange);font-size:13px;font-weight:900;letter-spacing:.12em}
.dc-customer-grid h3{margin:14px 0 8px;font-size:21px;font-weight:850;line-height:1.2}
.dc-customer-grid p{margin:0;color:var(--dc-muted);font-size:14px;line-height:1.65}
.dc-service-row{min-height:300px}
.dc-service-row img{min-height:260px}
.dc-symptom-grid a:focus-visible,.dc-work-grid a:focus-visible{outline:3px solid var(--dc-orange);outline-offset:3px}
@media(max-width:900px){.dc-work-grid,.dc-customer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.dc-work-grid,.dc-customer-grid{grid-template-columns:1fr}.dc-work-grid img{height:240px}.dc-customer-grid article{padding:20px}}

@media(max-width:850px){.dc-hero-grid,.dc-method-grid,.dc-coverage-grid,.dc-about-grid{grid-template-columns:1fr}.dc-symptom-grid{grid-template-columns:repeat(2,1fr)}.dc-hero-image img{height:360px}.dc-about-grid img{height:300px}}
@media(max-width:600px){.dc-hero-grid{padding-block:178px 48px}.dc-hero .site-header--overlay .header-main{min-height:78px}.dc-hero .site-header--overlay .header-topline-inner{padding-block:.4rem}.dc-wrap{width:min(100% - 30px,1180px)}.dc-symptom-grid{grid-template-columns:1fr 1fr}.dc-symptom-grid a{min-height:170px;padding:16px}.dc-symptom-grid strong{font-size:16px}.dc-service-row,.dc-service-row.dc-reverse{grid-template-columns:1fr;gap:18px}.dc-service-row.dc-reverse .dc-service-copy,.dc-service-row.dc-reverse img{order:initial}.dc-service-row img{height:230px}.dc-method-cards{grid-template-columns:1fr}.dc-hero-grid{gap:30px}}
</style>
